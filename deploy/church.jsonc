{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "drone-mapper",
  "account_id": "9a3738264c656666e119161b8e811746",
  "main": "../worker/index.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVITY",
        "class_name": "ActivityStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ActivityStore"
      ]
    }
  ],
  "services": [
    {
      "binding": "MAIN_SITE",
      "service": "dry-heart-c633"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "dronemapper.churchofmalware.org",
      "custom_domain": true
    },
    {
      "pattern": "churchofmalware.org/work",
      "zone_name": "churchofmalware.org"
    },
    {
      "pattern": "churchofmalware.org/work/*",
      "zone_name": "churchofmalware.org"
    },
    {
      "pattern": "churchofmalware.org/",
      "zone_name": "churchofmalware.org"
    },
    {
      "pattern": "churchofmalware.org/index.html",
      "zone_name": "churchofmalware.org"
    },
    {
      "pattern": "churchofmalware.org/dronemapper-promo.css",
      "zone_name": "churchofmalware.org"
    }
  ]
}
