{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "drone-mapper",
  "account_id": "9a3738264c656666e119161b8e811746",
  "main": "../worker/index.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVITY",
        "class_name": "ActivityStore"
      },
      {
        "name": "NODES",
        "class_name": "NodeNetwork"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ActivityStore"
      ]
    },
    {
      "tag": "v2-nodes",
      "new_sqlite_classes": [
        "NodeNetwork"
      ]
    },
    {
      "tag": "v3-accounts",
      "new_sqlite_classes": [
        "AccountGuard"
      ]
    }
  ],
  "services": [
    {
      "binding": "MAIN_SITE",
      "service": "dry-heart-c633"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "dronemapper.churchofmalware.org",
      "custom_domain": true
    },
    {
      "pattern": "churchofmalware.org/work",
      "zone_name": "churchofmalware.org"
    },
    {
      "pattern": "churchofmalware.org/work/*",
      "zone_name": "churchofmalware.org"
    },
    {
      "pattern": "churchofmalware.org/",
      "zone_name": "churchofmalware.org"
    },
    {
      "pattern": "churchofmalware.org/index.html",
      "zone_name": "churchofmalware.org"
    },
    {
      "pattern": "churchofmalware.org/dronemapper-promo.css",
      "zone_name": "churchofmalware.org"
    }
  ],
  "vars": {
    "NODE_INGEST_ENABLED": "true",
    "AUTH_ENABLED": "true",
    "AUTH_ORIGIN": "https://dronemapper.churchofmalware.org",
    "AUTH_FROM": "dronemapper_signup@churchofmalware.org",
    "AUTH_REPLY_TO": "dronemapper_signup@churchofmalware.org",
    "AUTH_MAIL_PROVIDER": "cloudflare"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "dronemapper-accounts",
      "database_id": "fc0575fa-c73b-4d7a-8738-ab6d04de5cba",
      "migrations_dir": "../migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_EDGE",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "allowed_sender_addresses": [
        "dronemapper_signup@churchofmalware.org"
      ]
    }
  ],
  "limits": {
    "cpu_ms": 10000
  }
}
